{
  "schemaVersion": 1,
  "id": "fumo-utils",
  "version": "${version}",
  "name": "Fumo Utils",
  "description": "A based addon for Meteor Client.",
  "authors": [
    "qnx"
  ],
  "contact": {
    "sources": "https://github.com/qnxt/fumo-utils"
  },
  "license": "GPL-3.0",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "sh.qnx.fumo.FumoUtils"
    ]
  },
  "mixins": [
    "fumo-utils.mixins.json"
  ],
  "accessWidener": "fumo-utils.accesswidener",
  "custom": {
    "meteor-client:color": "186,245,242"
  },
  "depends": {
    "fabricloader": "*",
    "minecraft": "*",
    "java": ">=25",
    "meteor-client": "*"
  }
}
